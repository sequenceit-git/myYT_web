# ==============================================================================
# ytCash Production Environment Configuration for Traefik & Docker
# ==============================================================================

# Your main public domain
DOMAIN=ytcash.pro

# (Optional) Dedicated API subdomain
API_DOMAIN=api.ytcash.pro

# The name of your existing Docker network used by Traefik (usually "traefik_web" or "proxy")
TRAEFIK_NETWORK=traefik_web

# The name of your Traefik ACME SSL certificate resolver (usually "letsencrypt" or "le" or "myresolver")
CERT_RESOLVER=letsencrypt

# MongoDB Connection URI (Self-contained Docker Mongo on the server)
MONGODB_URI=mongodb://mongo:27017/ytcash

# Redis Password for internal task queue
REDIS_PASSWORD=myyt_super_secure_redis_pass_2026

# JWT Security Keys
JWT_SECRET=super-secret-myyt-access-key-2026-production
JWT_REFRESH_SECRET=super-secret-myyt-refresh-key-2026-production

# Admin Backoffice Key & Control Desk Password (for accessing /admin panel)
ADMIN_PASSWORD=myyt@2026
ADMIN_SECRET_KEY=admin123

# Google OAuth Credentials (for Google Sign In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@ytcash.pro
FAUCETPAY_API_KEY=your_faucetpay_api_key_here
FAUCETPAY_MERCHANT_USERNAME=your_faucetpay_username_here


# (Optional) Video Cooldown Settings (set true to limit repeat watching per viewer)
ENABLE_COOLDOWN=false
VIDEO_COOLDOWN_SECONDS=0
